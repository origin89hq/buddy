{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "origin89-buddy-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BUDDY_MODE": "live",
    "BUDDY_MODEL": "openai/gpt-5.6-sol",
    "BUDDY_CHAT_MODEL": "openai/gpt-5.6-luna"
  },
  "ai": { "binding": "AI", "remote": true },
  // Local D1 until a production database is explicitly provisioned and seeded.
  "d1_databases": [{ "binding": "KNOWLEDGE", "database_name": "origin89-equipment-knowledge", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "origin89-buddy-poc-photos" }],
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "BuddySession" },
      { "name": "BUDGET", "class_name": "PreviewBudget" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuddySession", "PreviewBudget"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "fixture": {
      "vars": { "BUDDY_MODE": "fixture", "BUDDY_MODEL": "fixture-no-inference", "BUDDY_CHAT_MODEL": "fixture-no-inference" },
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "origin89-buddy-fixture-photos" }],
      "durable_objects": {
        "bindings": [
          { "name": "SESSIONS", "class_name": "BuddySession" },
          { "name": "BUDGET", "class_name": "PreviewBudget" }
        ]
      }
    }
  }
}
