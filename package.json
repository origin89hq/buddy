{
  "name": "origin89-buddy-repository",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "check": "pnpm lint && pnpm --filter @origin89/buddy build && pnpm --filter origin89-buddy check && pnpm --filter @origin89/buddy test && pnpm --filter origin89-buddy test && pnpm --filter origin89-buddy dry-run",
    "lint": "biome ci . --error-on-warnings",
    "package": "node scripts/package-contract.mjs",
    "buddy:test": "pnpm --filter @origin89/buddy test && pnpm --filter origin89-buddy test",
    "buddy:eval:dev": "pnpm --filter origin89-buddy eval:dev",
    "buddy:dev": "pnpm --filter origin89-buddy dev",
    "buddy:check": "pnpm --filter origin89-buddy check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13"
  },
  "license": "UNLICENSED"
}
